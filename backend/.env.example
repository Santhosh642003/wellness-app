# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname   # Railway auto-injects from Postgres plugin
JWT_SECRET=change-me-use-a-long-random-string-in-production

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001                        # Railway auto-injects; leave unset to default to 3001
JWT_EXPIRES_IN=7d

# ── CORS — set to your actual frontend/admin URLs ────────────────────────────
FRONTEND_URL=https://your-frontend.railway.app
ADMIN_URL=https://your-admin.railway.app
APP_URL=https://your-frontend.railway.app   # Used in password-reset email links

# ── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@njit.edu
ADMIN_PASSWORD=change-me

# ── Google OAuth (optional — email/password login still works without this) ──
GOOGLE_CLIENT_ID=                # Server-side token verification

# ── Transactional email — set ONE of Resend or SMTP (Resend takes priority) ───
# Without at least one, the server throws 503 in production when email is needed.

# Resend (recommended for Railway — sends over HTTPS, no port blocking)
RESEND_API_KEY=re_...            # Get from resend.com/api-keys
RESEND_FROM=onboarding@resend.dev  # Use verified domain address once domain is added

# SMTP (fallback — works on local/dev networks; Railway blocks outbound SMTP ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                # true for port 465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="NJIT Campus Wellness" <you@gmail.com>

# ── S3 / cloud storage (optional — falls back to local ./uploads/ disk) ──────
# Local disk is NOT persistent on Railway across deploys; configure S3 for prod.
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=                     # Only needed for non-AWS S3-compatible providers
S3_PUBLIC_URL=                   # CDN URL for public asset access (optional)

# ── Groq Whisper transcription (optional) ────────────────────────────────────
GROQ_API_KEY=                    # Enables POST /api/transcribe
