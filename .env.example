# ── Docker Compose only ──────────────────────────────────────────────────────
# These are used by docker-compose.yml to configure the postgres container and
# build/run the other services. On Railway, set vars in the dashboard instead.

# Postgres container credentials (Docker Compose only)
POSTGRES_DB=wellness_db
POSTGRES_USER=wellness_user
POSTGRES_PASSWORD=change-me

# Build arg for the frontend image (baked into JS at build time)
VITE_GOOGLE_CLIENT_ID=          # Google OAuth web client ID (optional)

# ── Passed through to backend by docker-compose.yml ─────────────────────────
# See backend/.env.example for full descriptions of each backend variable.

JWT_SECRET=change-me-use-a-long-random-string-in-production
ADMIN_EMAIL=admin@njit.edu
ADMIN_PASSWORD=Admin@1234

# Optional — leave blank to use local ./uploads/ folder for file storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional — Google OAuth for student login
GOOGLE_CLIENT_ID=

# Optional — SMTP for OTP emails and password reset
SMTP_USER=
SMTP_PASS=

# Optional — Groq Whisper transcription
GROQ_API_KEY=
